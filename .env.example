# Public build-time settings only. Every value here ends up visible to visitors.
# Never put GitHub tokens, publishing keys or private email addresses in this file.
# Blank values fall back to site.config.json.

# Public Jamstacks website ID (from the Jamstacks portal). Leave blank for the static email fallback.
JAMSTACKS_SITE=
# Public component asset base. Defaults to https://cdn.jamstacks.net.
NEXT_PUBLIC_JAMSTACKS_CDN_URL=
# Hostname only, e.g. example.com. Used for canonical URLs when PAGES_BASE_URL is unset.
NEXT_PUBLIC_SITE_DOMAIN=

# IANA time zone for opening hours, e.g. Europe/London. Defaults to site.config.json "timeZone".
SITE_TIME_ZONE=

# Optional local preview of a GitHub Pages project URL, e.g. /my-site.
PAGES_BASE_PATH=

# Local Jamstacks development only, e.g. NEXT_PUBLIC_JAMSTACKS_CDN_URL=https://localhost:5001/_cdn
# Ignored (and rejected) in GitHub Actions builds.
JAMSTACKS_ALLOW_LOCAL_CDN=

# Actual deployed origin and path; takes precedence over configured domain for metadata.
PAGES_BASE_URL=
